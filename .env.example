# Copy this file to .env and fill in real values for local development.
# See README.md for what each variable does and where to get it.
# Never commit .env — it's gitignored.

# --- Apify (required) ---
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR_ID=
APIFY_LINKEDIN_SEARCH_ACTOR_ID=

# --- Search behavior ---
LINKEDIN_INTENT_KEYWORDS=looking for an agency, need help with marketing
LINKEDIN_COMPANY_NEWS_KEYWORDS=
LINKEDIN_POST_DATE_FILTER=past-week
MAX_NEW_PROFILES_PER_RUN=25
LINKEDIN_PROFILE_URLS=

# --- Google Sheets (required; or use credentials/google-service-account.json instead) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# --- Optional: Claude-generated Connection Message column ---
ANTHROPIC_API_KEY=
